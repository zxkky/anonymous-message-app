<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | @<%= user.username %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 font-sans antialiased min-h-screen">

    <%- include('partials/nav') %>

    <div class="max-w-3xl mx-auto px-6 pt-28 pb-16">

        <!-- Welcome Card -->
        <div class="bg-gradient-to-r from-violet-600 to-indigo-600 rounded-3xl p-8 mb-6 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 w-40 h-40 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2"></div>
            <div class="relative">
                <h1 class="text-2xl font-bold mb-1">Halo, <%= user.username %>! 👋</h1>
                <p class="text-indigo-100 text-sm">Bagikan link ini agar orang lain bisa mengirim pesan anonim kepadamu</p>
            </div>
        </div>

        <!-- NGL Link -->
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 mb-6">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Link NGL Kamu</p>
            <div class="flex items-center gap-3">
                <div class="flex-1 bg-gray-50 rounded-2xl px-5 py-3.5 border border-gray-100">
                    <span id="nglLink" class="text-indigo-600 font-mono text-sm font-semibold"><%= 'http://localhost:3000/@' + user.username %></span>
                </div>
                <button id="copyButton" class="bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-700 hover:to-indigo-700 text-white font-bold py-3.5 px-6 rounded-2xl text-sm transition-all duration-200 shadow-lg shadow-indigo-200 hover:shadow-xl whitespace-nowrap">
                    📋 Copy
                </button>
            </div>
        </div>

        <!-- Stats -->
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Total Pesan Diterima</p>
                    <p class="text-4xl font-black text-gray-900 mt-1"><%= messageCount %></p>
                </div>
                <div class="w-16 h-16 bg-indigo-100 rounded-2xl flex items-center justify-center text-3xl">📨</div>
            </div>
        </div>

        <!-- Messages -->
        <div class="mb-4">
            <h3 class="text-lg font-bold text-gray-900">Pesan Masuk</h3>
        </div>

        <% if (messages.length === 0) { %>
            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-12 text-center">
                <div class="text-5xl mb-4">📭</div>
                <p class="text-gray-500 font-medium">Belum ada pesan anonim</p>
                <p class="text-gray-400 text-sm mt-1">Bagikan link-mu untuk mulai menerima pesan!</p>
            </div>
        <% } else { %>
            <div class="space-y-3">
                <% messages.forEach(function(msg) { %>
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 hover:shadow-md transition-all duration-200">
                        <p class="text-gray-800 text-sm leading-relaxed"><%= msg.message %></p>
                        <p class="text-gray-400 text-xs mt-3">
                            📅 <%= new Date(msg.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                        </p>
                    </div>
                <% }); %>
            </div>
        <% } %>

    </div>

    <script>
        document.getElementById('copyButton').addEventListener('click', function() {
            const link = document.getElementById('nglLink').textContent;
            navigator.clipboard.writeText(link).then(() => {
                const btn = document.getElementById('copyButton');
                btn.textContent = '✅ Copied!';
                btn.classList.remove('from-violet-600', 'to-indigo-600', 'hover:from-violet-700', 'hover:to-indigo-700');
                btn.classList.add('bg-green-500');
                setTimeout(() => {
                    btn.textContent = '📋 Copy';
                    btn.classList.remove('bg-green-500');
                    btn.classList.add('from-violet-600', 'to-indigo-600', 'hover:from-violet-700', 'hover:to-indigo-700');
                }, 2000);
            });
        });
    </script>

</body>
</html>
